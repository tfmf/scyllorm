{
    "name": "scyllorm",
    "version": "0.3.0",
    "description": "A TypeScript ORM for ScyllaDB",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tfmf/scyllorm.git"
    },
    "keywords": [
        "ScyllaDB",
        "ORM",
        "cassandra",
        "cql",
        "nosql",
        "database",
        "Scylla"
    ],
    "author": "Tiago Ferreira",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
