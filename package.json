        "tslib": "^2.6.3"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.7.0",
        "@typescript-eslint/parser": "^7.7.0",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.1.0",
        "vitest": "^4.0.18"
    }
}
