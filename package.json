{
    "name": "scyllorm",
    "version": "0.5.0",
    "description": "A TypeScript ORM for ScyllaDB",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tfmf/scyllorm.git"
    },
    "keywords": [
        "ScyllaDB",
        "ORM",
        "cassandra",
        "cql",
        "nosql",
        "database",
        "Scylla"
    ],
    "author": "Tiago Ferreira",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "bash scripts/e2e.sh",
        "coverage:badge": "node scripts/coverage-badge.mjs --write",
        "coverage:badge:check": "node scripts/coverage-badge.mjs",
        "prepare": "npm run build"
    },
    "dependencies": {
        "cassandra-driver": "^4.9.0",
        "tslib": "^2.6.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.1.0",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "cassandra-driver": {
            "adm-zip": "^0.6.0"
        }
    }
}
